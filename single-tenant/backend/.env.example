# ==========================================
# KOPIGO SINGLE-TENANT BACKEND CONFIG TEMPLATE
# ==========================================

PORT=8090
NODE_ENV=development

# Database Connection (PostgreSQL & PostGIS)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=kopigo_db
DB_POOL_MAX=20
DB_POOL_MIN=4

# Redis Connection (Cache, Distributed Locks & BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_chars_long
JWT_EXPIRES=1d
REFRESH_TOKEN_DAYS=30

# Frontend URL & CORS Whitelist
FRONTEND_URL=http://localhost:8074
ADDITIONAL_ALLOWED_ORIGINS=http://127.0.0.1:8074

# SMTP Mailer (Ethereal Dev / Production SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_user@ethereal.email
SMTP_PASS=your_smtp_password
SMTP_FROM="KopiGo Control Room" <noreply@kopigo.id>

# Cloudflare Turnstile CAPTCHA
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA